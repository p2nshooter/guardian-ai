# ============================================================
# AXTO One-Click Deployer — Environment Variables
# Rename file ini menjadi .env dan isi semua nilainya
# ⚠️  JANGAN pernah commit file .env ke GitHub!
# ============================================================


# ────────────────────────────────────────────────────────────
# 1. CLOUDFLARE ACCOUNT
# Dapatkan dari: https://dash.cloudflare.com
# → kanan atas halaman → "Account ID" (copy nilai tersebut)
# ────────────────────────────────────────────────────────────
CF_ACCOUNT_ID=your_cloudflare_account_id_here


# ────────────────────────────────────────────────────────────
# 2. CLOUDFLARE API TOKEN
# Buat di: https://dash.cloudflare.com/profile/api-tokens
# → Create Token → Create Custom Token
# Permissions yang dibutuhkan:
#   - Account → D1         → Edit
#   - Account → Cloudflare R2 Storage → Edit
# ────────────────────────────────────────────────────────────
CF_API_TOKEN=your_cloudflare_api_token_here


# ────────────────────────────────────────────────────────────
# 3. D1 DATABASE ID
# Dapatkan dari: Cloudflare Dashboard → Workers & Pages → D1
# → Klik database kamu → copy "Database ID" (UUID format)
# Contoh: d1abc123-1234-5678-abcd-ef0123456789
# ────────────────────────────────────────────────────────────
D1_DATABASE_ID=your_d1_database_id_here


# ────────────────────────────────────────────────────────────
# 4. R2 API CREDENTIALS
# Buat di: Cloudflare Dashboard → R2 → Manage R2 API Tokens
# → Create API Token
# Permission: Object Read & Write
# Scope: Specific bucket → axto-storage
# ────────────────────────────────────────────────────────────
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here


# ────────────────────────────────────────────────────────────
# 5. R2 BUCKET NAME
# Nama bucket R2 (bukan URL, hanya nama saja)
# ────────────────────────────────────────────────────────────
R2_BUCKET_NAME=axto-storage


# ════════════════════════════════════════════════════════════
# OPSI TAMBAHAN (tidak perlu diubah untuk pemakaian normal)
# ════════════════════════════════════════════════════════════

# Path prefix di dalam R2 bucket
# PDF akan tersimpan sebagai: playbooks/nama-file.pdf
R2_PREFIX=playbooks/

# true = jalankan ulang semua migration meski sudah pernah dijalankan
# Default: false (skip yang sudah dijalankan — aman & cepat)
FORCE_MIGRATIONS=false

# true = upload ulang PDF meski sudah ada di R2
# Default: false (skip yang sudah ada)
FORCE_REUPLOAD=false
