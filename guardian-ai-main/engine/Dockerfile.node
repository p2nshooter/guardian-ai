FROM python:3.11-slim

LABEL org.opencontainers.image.source="https://github.com/p2nshooter/guardian-ai"
LABEL org.opencontainers.image.title="AXTO Guardian Node Agent"
LABEL org.opencontainers.image.description="AXTO Guardian — Node Agent (threat detection, runs on each protected server)"
LABEL org.opencontainers.image.licenses="Commercial"

# System deps: network tools needed by node agent (iptables, iproute2, etc.)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ python3-dev libssl-dev libffi-dev libpq-dev \
    curl procps iproute2 iptables libcap2-bin \
    net-tools tcpdump \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /guardian

COPY requirements.txt .

RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir -r requirements.txt \
 && apt-get purge -y gcc g++ python3-dev libssl-dev libffi-dev libpq-dev \
 && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/* /root/.cache/pip

COPY src/ ./src/

RUN mkdir -p /guardian/data /guardian/logs /guardian/config /guardian/quarantine

# Node agent entrypoint — runs src/__main__.py → node.py (NOT the API server)
# Requires: GUARDIAN_CORE_URL env var pointing to guardian-core container
ENV GUARDIAN_CONFIG=/guardian/config/guardian.yml

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8081/health || exit 1

CMD ["python", "-m", "src"]
