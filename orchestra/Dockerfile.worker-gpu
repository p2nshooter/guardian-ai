# ── AXTO Orchestra Worker GPU — Full Capability (~4-5GB) ─────────────────────
#
# Capabilities by VRAM:
#   < 8 GB  → chat (small models via Ollama) + transcription (Whisper)
#   8–16 GB → chat + embedding + transcription + DALL-E via API
#   > 16 GB → ALL: chat + image gen (SDXL local) + embedding + transcription
#
# One Dockerfile, one image per GPU brand (REQUESTS 136, BLUEPRINT-V4 §31.F G3).
# Every layer is the same except the PyTorch build chosen by GPU_VARIANT:
#   cuda (default) → axto/orchestra-worker-gpu        NVIDIA  (docker run --gpus all …)
#   rocm           → axto/orchestra-worker-gpu-amd    AMD     (--device /dev/kfd --device /dev/dri)
# The same image runs on Linux and on Windows (Docker Desktop, WSL 2); Docker
# Desktop passes only NVIDIA GPUs into containers, so AMD images are for Linux.
# Detection, telemetry and the GPU test (python -m orchestra_worker.probe) need
# no vendor tool: sysfs and hwmon cover AMD; nvidia-smi comes with the NVIDIA runtime.
# CPU fallback always works.
#
# PyTorch is installed AFTER requirements to avoid pip pulling a CPU-only wheel.
# ─────────────────────────────────────────────────────────────────────────────
FROM python:3.11-slim-bookworm

ARG GPU_VARIANT=cuda

LABEL org.opencontainers.image.source="https://github.com/your-org/guardian-ai"
LABEL org.opencontainers.image.title="AXTO Orchestra Worker GPU"
LABEL org.opencontainers.image.licenses="Commercial"

# System deps:
#   pciutils (lspci)                    : GPU detection without nvidia-smi/rocm-smi
#   ffmpeg + libav*                     : audio transcription (faster-whisper)
#   libgomp1                            : OpenMP for ML libs
#   libglib2.0-0 libsm6 libxext6       : diffusers/PIL dependencies
#   curl                                : health check
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl gcc g++ python3-dev libssl-dev libffi-dev \
    pciutils \
    ffmpeg libavformat-dev libavcodec-dev libavutil-dev \
    libgomp1 \
    libglib2.0-0 libsm6 libxext6 libxrender-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY orchestra_worker/requirements.txt      ./requirements.txt
COPY orchestra_worker/requirements-gpu.txt  ./requirements-gpu.txt

# Step 1: Install base + GPU deps (diffusers, transformers, whisper, etc.)
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir -r requirements.txt \
 && pip install --no-cache-dir -r requirements-gpu.txt

# Step 2: PyTorch for this GPU brand (same version everywhere)
# cuda: CUDA 12.1 wheels (~2.5 GB) · rocm: ROCm 6.2 wheels (bundle the ROCm runtime)
RUN case "$GPU_VARIANT" in \
      cuda) IDX=https://download.pytorch.org/whl/cu121 ;; \
      rocm) IDX=https://download.pytorch.org/whl/rocm6.2 ;; \
      *) echo "unknown GPU_VARIANT '$GPU_VARIANT' (cuda | rocm)" >&2; exit 1 ;; \
    esac \
 && pip install --no-cache-dir \
    torch==2.5.1 \
    torchvision==0.20.1 \
    torchaudio==2.5.1 \
    --index-url "$IDX"

# Step 3: Clean up build tools (keep runtime libs)
RUN apt-get purge -y gcc g++ python3-dev libssl-dev libffi-dev 2>/dev/null || true \
 && apt-get autoremove -y \
 && rm -rf /root/.cache/pip /tmp/pip-* \
 && find /usr/local/lib/python3.11 -name "*.pyc" -delete 2>/dev/null || true

COPY orchestra_worker/ ./orchestra_worker/
COPY orchestra_core/   ./orchestra_core/

RUN mkdir -p /app/data /app/logs /app/models \
 && touch /app/orchestra_worker/__init__.py \
 && touch /app/orchestra_core/__init__.py

ENV AXTO_STATE_DIR=/app/data/.axto
ENV DATA_DIR=/app/data
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python -c "import os, urllib.request; urllib.request.urlopen('http://127.0.0.1:' + os.environ.get('WORKER_PORT', '7892') + '/health', timeout=8)" || exit 1

ENV WORKER_TYPE=gpu
ENV GPU_VARIANT=${GPU_VARIANT}

CMD ["python", "-m", "orchestra_worker.worker_gpu"]