# ============================================================
# AXTO Dashboard — Environment Variables
# Copy to .env.local for local dev with wrangler pages dev
# NEVER commit real secrets to git
# ============================================================

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://axto.io
NEXT_PUBLIC_APP_NAME=AXTO

# ── Auth (generate: openssl rand -base64 48) ─────────────────
JWT_SECRET=change-this-to-a-long-random-string

# ── Encryption (generate: openssl rand -hex 32) ──────────────
ENCRYPTION_KEY=64-hex-chars-here

# ── Admin password (for /api/auth password_login) ────────────
ADMIN_PASSWORD=your-strong-admin-password

# ── Email (Resend — https://resend.com) ──────────────────────
RESEND_API_KEY=re_xxxx
EMAIL_FROM=AXTO <hello@axto.io>

# ── Cron auth ────────────────────────────────────────────────
CRON_SECRET=change-this-cron-secret

# ── AutoPost AI (Anthropic for text variations) ──────────────

# ── Cloudflare R2 (optional — for file storage) ──────────────
CF_R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ── GHCR (GitHub Container Registry owner) ───────────────────
GHCR_OWNER=your-org

# ── GitHub Actions API (for triggering Docker builds) ────────
# Generate at: github.com/settings/tokens → fine-grained → actions:write
GITHUB_TOKEN=ghp_your_token_here
GITHUB_OWNER=your-org
GITHUB_REPO=guardian-engine

# ── Build Webhook (optional alternative to GitHub API) ───────
BUILD_WEBHOOK_SECRET=change-this-build-webhook-secret

# ── GitLab CI (for Engine Builder auto-build trigger) ────────
GITLAB_TOKEN=glpat-xxxx
GITLAB_PROJECT=axto-platform/guardian-ai

