{
  "name": "axto-dashboard",
  "version": "2.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "pages:build": "npx @cloudflare/next-on-pages",
    "start": "next start",
    "lint": "next lint",
    "preview": "wrangler pages dev",
    "db:migrate": "wrangler d1 migrations apply axto-db",
    "db:migrate:prod": "wrangler d1 migrations apply axto-db --remote"
  },
  "dependencies": {
    "next": "15.1.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^17.5.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1",
    "@cloudflare/workers-types": "^4.20250310.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "wrangler": "^3.99.0"
  }
}
