{
  "name": "axto-dashboard",
  "version": "2.2.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/vendor.mjs && next dev",
    "build": "node scripts/vendor.mjs && next build",
    "pages:build": "npx @cloudflare/next-on-pages",
    "start": "next start",
    "preview": "wrangler pages dev",
    "db:migrate": "wrangler d1 migrations apply axto-db",
    "db:migrate:prod": "wrangler d1 migrations apply axto-db --remote",
    "test": "tsx --conditions=react-server --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p .",
    "test:e2e": "bash tests/e2e/run.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "next": "15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1",
    "@cloudflare/workers-types": "^4.20250310.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "pdfjs-dist": "^5.7.284",
    "postcss": "^8.4.49",
    "server-only": "^0.0.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^3.99.0"
  },
  "type": "module"
}
