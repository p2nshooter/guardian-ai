{
  "name": "axto-dashboard",
  "version": "3.2.1",
  "private": true,
  "scripts": {
    "dev": "node scripts/vendor.mjs && next dev",
    "build": "node scripts/vendor.mjs && next build",
    "pages:build": "npx @cloudflare/next-on-pages && node scripts/patch-worker.mjs",
    "start": "next start",
    "preview": "wrangler pages dev",
    "db:migrate": "wrangler d1 migrations apply axto-db",
    "db:migrate:prod": "wrangler d1 migrations apply axto-db --remote",
    "test": "tsx --conditions=react-server --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p .",
    "test:e2e": "bash tests/e2e/run.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.52.0",
    "next": "~15.1.12",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1",
    "@cloudflare/workers-types": "^4.20250310.0",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@mediapipe/tasks-vision": "^0.10.21",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/ind": "^1.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "mermaid": "^11.17.2",
    "pdfjs-dist": "^5.7.284",
    "postcss": "^8.4.49",
    "server-only": "^0.0.1",
    "tailwindcss": "^3.4.17",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^3.99.0"
  },
  "type": "module"
}
