# ==============================================================================
# AXTO Legal — Production Configuration
# Copyright (c) 2024-2026 Axto AI. All rights reserved.
# Platform: AXTO (axto.io) — Sovereign AI Infrastructure
# ==============================================================================
# Salin file ini ke .env dan isi nilainya sebelum menjalankan AXTO Legal.
# Semua nilai dapat dikonfigurasi via environment variables dengan prefix LEGL_

# ── WAJIB ────────────────────────────────────────────────────────────────────
LEGL_LICENSE_KEY=LEGL-XXXX-XXXX-XXXX-XXXX
LEGL_API_KEY=ganti-dengan-kunci-yang-kuat-minimal-32-karakter

# ── LLM Provider — BYOK (Bring Your Own Key) ─────────────────────────────────
# Pilih salah satu provider. Data TIDAK dikirim ke AXTO.

# Option 1: OpenAI
LEGL_LLM_PROVIDER=openai
LEGL_LLM_MODEL=gpt-4o-mini
LEGL_LLM_API_KEY=sk-...

# Option 2: Anthropic Claude
# LEGL_LLM_PROVIDER=anthropic
# LEGL_LLM_MODEL=claude-3-5-haiku-20241022
# LEGL_LLM_API_KEY=sk-ant-...

# Option 3: Google Gemini
# LEGL_LLM_PROVIDER=gemini
# LEGL_LLM_MODEL=gemini-2.0-flash-exp
# LEGL_LLM_API_KEY=AIza...

# Option 4: Groq (cepat, murah)
# LEGL_LLM_PROVIDER=groq
# LEGL_LLM_MODEL=llama-3.3-70b-versatile
# LEGL_LLM_API_KEY=gsk_...

# Option 5: Ollama (local/air-gapped, tanpa API key)
# LEGL_LLM_PROVIDER=ollama
# LEGL_OLLAMA_URL=http://localhost:11434
# LEGL_OLLAMA_MODEL=qwen2.5:7b

# ── Server ────────────────────────────────────────────────────────────────────
LEGL_API_HOST=0.0.0.0
LEGL_API_PORT=8096
LEGL_LOG_LEVEL=INFO

# ── Storage ───────────────────────────────────────────────────────────────────
LEGL_DATA_PATH=/legal/data
LEGL_UPLOAD_PATH=/legal/data/uploads
LEGL_OUTPUT_PATH=/legal/data/outputs
LEGL_INDEX_PATH=/legal/data/index
LEGL_MAX_UPLOAD_MB=100

# ── Keamanan ──────────────────────────────────────────────────────────────────
LEGL_REQUIRE_AUTH=true
LEGL_CORS_ORIGINS=*

# ── Fitur Opsional ────────────────────────────────────────────────────────────
LEGL_REGULATORY_UPDATE_ENABLED=true
LEGL_REGULATORY_UPDATE_INTERVAL_HOURS=6

# ── Data Source API Keys (Opsional — untuk sumber berbayar) ──────────────────
# LEGL_APIKEY_LIC01=<LexisNexis API Key>
# LEGL_APIKEY_LIC02=<Westlaw API Key>
# LEGL_APIKEY_LIC06=<Hukumonline API Key>
# LEGL_APIKEY_ODP01=<data.gov API Key>
# LEGL_APIKEY_FIN01=<SEC EDGAR Key>

# ── Ed25519 Signing Key Override (WAJIB di produksi) ─────────────────────────
# AXTO_SIGNING_PUBLIC_KEY_B64=<base64-encoded-production-public-key>
